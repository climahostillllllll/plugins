import { definePluginSettings } from "@api/Settings";
import definePlugin, { OptionType } from "@utils/types";
import { findStoreLazy } from "@webpack";
import * as Common from "@webpack/common";

// Helper de tradução simples (o módulo autoTranslateNightcord não existe no Equicord)
const t = (str: string) => str;

// Loja do Gateway do Discord (achada direto, sem depender de @webpack/common)
const GatewayConnectionStore = findStoreLazy("GatewayConnectionStore");

// Toast: o Equicord atual não exporta showToast/Toasts do mesmo jeito que o Vencord antigo.
// Usamos acesso dinâmico e, se não existir, caímos no console para não quebrar o plugin.
function toast(message: string) {
    try {
        const c = Common as any;
        if (typeof c.showToast === "function") {
            c.showToast(message, c.Toasts?.Type?.SUCCESS ?? "success");
            return;
        }
        if (typeof c.Toasts?.show === "function") {
            c.Toasts.show({
                message,
                type: c.Toasts.Type?.SUCCESS ?? "success",
                id: c.Toasts.genId?.() ?? String(Date.now())
            });
            return;
        }
    } catch { }
    console.log("[PlatformSpoofer]", message);
}

function getGatewaySocket() {
    try {
        return GatewayConnectionStore?.getSocket?.() ?? null;
    } catch {
        return null;
    }
}

function getSpoofedProperties() {
    const platform = settings.store.platform ?? "desktop";
    switch (platform) {
        case "desktop":
            return {
                os: "Windows",
                browser: "Discord Client",
                device: "",
                system_locale: "en-US"
            };
        case "web":
            return {
                os: "Windows",
                browser: "Discord Web",
                device: "",
                browser_user_agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
                browser_version: "128.0.0.0"
            };
        case "android":
            return {
                os: "Android",
                browser: "Discord Android",
                device: "Samsung Galaxy S24",
                os_version: "14",
                browser_user_agent: "Discord-Android/240000; Mozilla/5.0 (Linux; Android 14; SM-S928B)",
                system_locale: "en-US"
            };
        case "ios":
            return {
                os: "iOS",
                browser: "Discord iOS",
                device: "iPhone 15,3",
                os_version: "17.4",
                browser_user_agent: "Discord-iOS/240000; Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X)",
                system_locale: "en-US"
            };
        case "xbox":
            return {
                os: "Xbox",
                browser: "Discord Embedded",
                device: "Xbox Series X"
            };
        case "playstation":
            return {
                os: "PlayStation 5",
                browser: "Discord Embedded",
                device: "PlayStation 5"
            };
        case "vr":
            return {
                os: "Android",
                browser: "Discord VR",
                device: "Meta Quest 3"
            };
        default:
            return {
                os: "Windows",
                browser: "Discord Client",
                device: ""
            };
    }
}

function reconnectGateway() {
    try {
        const socket = getGatewaySocket();
        if (socket) {
            if (typeof socket.close === "function") {
                socket.close();
            } else if (socket.ws && typeof socket.ws.close === "function") {
                socket.ws.close();
            }
            toast(t("Platform updated! Reconnecting Gateway..."));
        } else {
            toast(t("Platform updated!"));
        }
    } catch {
        toast(t("Platform updated!"));
    }
}

const settings = definePluginSettings({
    platform: {
        type: OptionType.SELECT,
        description: "What platform to show up as on",
        options: [
            { label: "Desktop (Windows)", value: "desktop", default: true },
            { label: "Web Browser", value: "web" },
            { label: "Android Mobile", value: "android" },
            { label: "iOS (iPhone)", value: "ios" },
            { label: "Xbox Series", value: "xbox" },
            { label: "PlayStation 5", value: "playstation" },
            { label: "VR (Meta Quest)", value: "vr" },
        ],
        onChange: () => {
            reconnectGateway();
        }
    }
});

let unpatches: (() => void)[] = [];

export default definePlugin({
    name: "PlatformSpoofer",
    description: "Spoof what platform or device you're on instantly without reloading Discord",
    tags: ["Utility"],
    authors: [
        {
            name: "Nightcord",
            id: 0n
        }
    ],
    settings,

    start() {
        unpatches = [];
        const socket = getGatewaySocket();
        if (!socket) return;

        const proto = Object.getPrototypeOf(socket);
        if (proto && typeof proto.send === "function") {
            const origSend = proto.send;
            proto.send = function (op: number, data: any, ...rest: any[]) {
                if (op === 2 && data?.properties) {
                    try {
                        const spoofed = getSpoofedProperties();
                        Object.assign(data.properties, spoofed);
                    } catch { }
                }
                return origSend.call(this, op, data, ...rest);
            };
            unpatches.push(() => {
                proto.send = origSend;
            });
        }

        // Também patcha a instância direta do socket, se existir
        if (typeof socket.send === "function" && socket.send !== proto.send) {
            const origInstSend = socket.send;
            socket.send = function (op: number, data: any, ...rest: any[]) {
                if (op === 2 && data?.properties) {
                    try {
                        const spoofed = getSpoofedProperties();
                        Object.assign(data.properties, spoofed);
                    } catch { }
                }
                return origInstSend.call(this, op, data, ...rest);
            };
            unpatches.push(() => {
                socket.send = origInstSend;
            });
        }

        // Reconecta se a plataforma não for a padrão, para aplicar o spoof na hora
        if (settings.store.platform && settings.store.platform !== "desktop") {
            reconnectGateway();
        }
    },

    stop() {
        for (const unpatch of unpatches) {
            try { unpatch(); } catch { }
        }
        unpatches = [];
        // Reconecta para restaurar a identificação original da plataforma
        reconnectGateway();
    }
});
